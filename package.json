{
  "name": "swasthyasetu-ai",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "node scripts/patch-metro.cjs",
    "dev": "npm run dev -w @setu/web",
    "web": "npm run dev -w @setu/web",
    "mobile": "npm run start -w @setu/mobile",
    "build": "npm run build -w @setu/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.13"
  },
  "overrides": {
    "decode-uri-component": "0.5.1",
    "image-size": "2.0.3",
    "postcss": "^8.5.23",
    "glob": "14.0.2",
    "minimatch": "11.0.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}
